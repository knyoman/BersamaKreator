# Local setup/test scripts
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_SME_EMAIL=sme@example.com
SEED_SME_PASSWORD=change-this-password
SEED_INFLUENCER_EMAIL=influencer@example.com
SEED_INFLUENCER_PASSWORD=change-this-password
TEST_LOGIN_EMAIL=sme@example.com
TEST_LOGIN_PASSWORD=change-this-password
