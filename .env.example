# Supabase Configuration (Production)
VITE_SUPABASE_URL=your-production-supabase-url
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Edge Functions (Production)
VITE_EDGE_FUNCTION_URL=https://your-production-domain/create-order
VITE_EDGE_FUNCTION_AI_URL=https://your-production-domain/ai-match
VITE_EDGE_FUNCTION_ORDER_STATUS_URL=https://your-production-domain/update-order-status
VITE_EDGE_FUNCTION_INFLUENCER_AI_URL=https://your-production-domain/influencer-ai-assistant
VITE_EDGE_FUNCTION_CONTENT_STRATEGY_AI_URL=https://your-production-domain/content-strategy-agent
VITE_EDGE_FUNCTION_MARKET_RESEARCH_AI_URL=https://your-production-domain/market-research-agent
VITE_EDGE_FUNCTION_ICP_AI_URL=https://your-production-domain/icp-agent
VITE_EDGE_FUNCTION_COMPETITOR_ANALYSIS_AI_URL=https://your-production-domain/competitor-analysis-agent
VITE_EDGE_FUNCTION_SOCIAL_POST_AI_URL=https://your-production-domain/social-post-agent
VITE_EDGE_FUNCTION_EMAIL_CAMPAIGN_AI_URL=https://your-production-domain/email-campaign-agent
VITE_EDGE_FUNCTION_AD_COPY_AI_URL=https://your-production-domain/ad-copy-agent
VITE_EDGE_FUNCTION_MARKETING_OPS_AI_URL=https://your-production-domain/marketing-ops-agent
VITE_ALLOWED_ORIGINS=https://your-production-domain
VITE_PUBLIC_SME_COUNT_ESTIMATE=0
VITE_PUBLIC_SUCCESS_RATE_ESTIMATE=95

# For Edge Functions (Server-side environment variables)
SUPABASE_URL=your-production-supabase-url
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-server-functions-only
GEMINI_API_KEY=your-production-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_ASSISTANT_PROVIDER=auto
ALLOWED_ORIGINS=https://your-production-domain
ENABLE_SERVER_LOGS=false

# Local AI testing endpoints
# Use these in .env.local while running npm run dev:all or npm run dev:api.
# VITE_EDGE_FUNCTION_AI_URL=http://127.0.0.1:8080/ai-match
